{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "additionalBranchPrefix": "{{packageFileDir}}-",
  "commitMessagePrefix": "[{{packageFileDir}}] ",

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Chart\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s?renovate: image=(?<depName>.*?)\\s?appVersion:\\s?\\\"?(?<currentValue>[\\w+\\.\\-]*)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/).*\\.ya?ml$/"
      ],
      "matchStrings": [
        "requested_binary_repo_version:\\s*\"?(?<depName>[^:\"]+?):(?<currentValue>[^\"\r\n]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?:.+/)?v?(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)execution-environment\\.ya?ml$/"
      ],
      "matchStrings": [
        "base_image:\\s*\\n\\s*name:\\s*\"?(?<depName>[^:\"\\s]+):(?<currentValue>[^@\"\\s]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?-(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Helm chart pinned in a deploy-k8s.sh script via CHART_NAME, REPO_URL (repo charts only) and VERSION",
      "managerFilePatterns": [
        "/(^|/)deploy-k8s\\.sh$/"
      ],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "\\nCHART_NAME=\"?(?:oci://)?(?<depName>[^\"\\s]+)\"?",
        "\\nREPO_URL=\"?(?<registryUrl>https?://[^\"\\s]+)\"?",
        "\\nVERSION=\"?(?<currentValue>[^\"\\s#]+)\"?"
      ],
      "datasourceTemplate": "{{#if registryUrl}}helm{{else}}docker{{/if}}",
      "depNameTemplate": "{{#if registryUrl}}{{{replace '^[^/]+/' '' depName}}}{{else}}{{{depName}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Any VAR=version line preceded by a '# renovate: datasource=... depName=...' annotation, or a VAR=<git commit> line whose annotation names the branch it follows with currentValue=...",
      "managerFilePatterns": [
        "/\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+registryUrl=(?<registryUrl>\\S+))?(\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n[A-Z_]+=\"?(?<currentValue>[^\"\\s#]+)\"?",
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+currentValue=(?<currentValue>\\S+)\\s*\\n[A-Z_]+=\"?(?<currentDigest>[0-9a-f]{40})\"?"
      ]
    },
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/(^|/)deploy.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "$[].vars.requested_image_version.*.( $ref := $substringBefore($, \"@\"); $m := $match($ref, /^(.+):([^:\\/]+)$/); { \"depName\": $m ? $m.groups[0] : $ref, \"currentValue\": $m.groups[1], \"currentDigest\": $contains($, \"@\") ? $substringAfter($, \"@\") } )"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Exact pip pins in an execution environment definition",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)execution-environment\\.ya?ml$/"
      ],
      "matchStrings": [
        "package_pip:\\s*(?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[^\\s\"]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Exact pip pins in an execution environment definition's python list (name==version, extras allowed)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)execution-environment\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "\\n\\s+python:\\s*\\n(?:\\s+-[^\\n]*\\n)+",
        "\\n\\s+-\\s+(?<depName>[A-Za-z0-9._-]+)(?:\\[[^\\]\\n]*\\])?==(?<currentValue>[^\\s\"#]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "pipx packages pinned as pkg==version in a pipx_packages list",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "pipx_packages:\\s*\\n(?:[ \\t]+- [^\\n]+\\n)+",
        "- (?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[^\\s\"]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],

  "enabledManagers": [
    "ansible-galaxy",
    "custom.regex",
    "custom.jsonata",
    "dockerfile",
    "helmv3",
    "helm-values",
    "kubernetes",
    "kustomize",
    "pre-commit"
  ],

  "helm-values": {
    "managerFilePatterns": [
      "/(^|/).*values.*\\.ya?ml$/"
    ]
  },

  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)extra-manifests/[^/]+\\.ya?ml$/"
    ]
  },

  "packageRules": [
    {
      "description": "Images in plain manifests usually follow another component's version (the CNI, the storage cluster): approve them from the Dependency Dashboard",
      "matchManagers": ["kubernetes"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Images pinned to release-X.Y.Z tags: compare them with plain X.Y.Z tags too, so a switch of tag scheme upstream is picked up",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "/^release-\\d+\\.\\d+\\.\\d+$/",
      "versioning": "regex:^(?:release-)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "A chart lives in <app>/chart: name its branch and commit after the App folder, so its appVersion bump joins the same image bump in the App values",
      "matchFileNames": ["**/chart/Chart.yaml"],
      "additionalBranchPrefix": "{{replace \"/chart$\" \"\" packageFileDir}}-",
      "commitMessagePrefix": "[{{replace \"/chart$\" \"\" packageFileDir}}] "
    },
    {
      "description": "One PR per App for the non-major updates of its images and charts; the branch prefix already names the App folder. Binary tools and pre-commit hooks keep one PR each",
      "matchDatasources": ["docker", "helm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "non-major updates",
      "groupSlug": "non-major"
    },
    {
      "description": "Major updates need a decision: open them from the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Molecule target images follow the hosts' OS versions: a new major is a new target, not an update",
      "matchFileNames": ["tests/molecule/images/**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Template placeholders such as <APP_VERSION> aren't versions: never look them up",
      "matchCurrentValue": "/^<.+>$/",
      "enabled": false
    }
  ],

  "pre-commit": {
    "enabled": true
  },

  "prHourlyLimit": 10,

  "schedule": ["before 6am on monday"]
}
