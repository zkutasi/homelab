{% set registries = cup_registries | default({}) %}
{% set control_server = cup_control_server | default('') %}
{% set servers = cup_servers | default({}) %}
{
{% if registries | length > 0 %}
  "registries": {
{% for registry in registries | dict2items %}
    "{{ registry.key }}": {
      "authentication": "{{ registry.value.authentication }}"{{ ", " if not loop.last else "" }}
    }
{% endfor %}
  }{{ ", " if registries | length > 0 else "" }}
{% endif %}
{% if control_server | length > 0 and inventory_hostname == control_server and servers | length > 0 %}
  "servers": {
{% for server in servers | dict2items %}
    "{{ server.key }}": "{{ server.value }}"{{ ", " if not loop.last else "" }}
{% endfor %}
  }
{% else %}
  "agent": true
{% endif %}
}
