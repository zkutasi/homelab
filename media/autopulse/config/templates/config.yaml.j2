app:
  api_logging: true

targets:
{% if plex_token is defined %}
  my_plex:
    type: "plex"
    url: "https://plex.{{ reverseproxy_internal_domain }}:443"
    token: "{{ plex_token }}"
    request:
      insecure: true
    rewrite:
      - from: "-hdd0[1-8]"
        to: ""
{% endif %}
{% if autopulse_emby_apikey is defined %}

  my_emby:
    type: "emby"
    url: "https://emby.{{ reverseproxy_internal_domain }}:443"
    token: "{{ autopulse_emby_apikey }}"
    request:
      insecure: true
    rewrite:
      - from: "-hdd0[1-8]"
        to: ""
{% endif %}
{% if autopulse_jellyfin_apikey is defined %}

  my_jellyfin:
    type: "jellyfin"
    url: "https://jellyfin.{{ reverseproxy_internal_domain }}:443"
    token: "{{ autopulse_jellyfin_apikey }}"
    request:
      insecure: true
    rewrite:
      - from: "-hdd0[1-8]"
        to: ""
{% endif %}
