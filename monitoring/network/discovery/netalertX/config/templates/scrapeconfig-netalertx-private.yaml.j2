apiVersion: monitoring.coreos.com/v1alpha1
kind: ScrapeConfig
metadata:
  name: netalertx
  labels:
    release: kube-prometheus-stack
spec:
  jobName: netalertx
  staticConfigs:
{% for host in groups['dnsserver'] | default([]) %}
{% if loop.first %}
    - targets: ["{{ hostvars[host].ansible_host }}:{{ port_netalertx_graphql }}"]
      labels:
        host: "{{ hostvars[host].id }}"
{% endif %}
{% endfor %}
  authorization:
    type: Bearer
    credentials:
      name: netalertx-api-token
      key: token
