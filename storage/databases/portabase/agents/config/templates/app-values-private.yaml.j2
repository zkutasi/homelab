configmap:
  config:
    enabled: true
    data:
      config.json: |
        {
          "databases": [
{% set portabase_dbs = (['grimmory'] if grimmory_db_user_password is defined else [])
                     + (['paperless'] if paperless_ngx_db_password is defined else [])
                     + (['wygiwyh'] if wygiwyh_database_password is defined else []) %}
{% if 'grimmory' in portabase_dbs %}
            {
              "name": "grimmory",
              "database": "booklore",
              "type": "mariadb",
              "host": "{{ hostvars[groups['books'][0]].ansible_host }}",
              "port": 33306,
              "username": "booklore",
              "password": "{{ grimmory_db_user_password }}",
              "generated_id": "019e91f5-bc09-74df-8e9c-b71507e5452f"
            }{{ ',' if portabase_dbs[-1] != 'grimmory' else '' }}
{% endif %}
{% if 'paperless' in portabase_dbs %}
            {
              "name": "paperless",
              "database": "paperless",
              "type": "postgresql",
              "host": "{{ hostvars[groups['documents'][0]].ansible_host }}",
              "port": 55432,
              "username": "paperless",
              "password": "{{ paperless_ngx_db_password }}",
              "generated_id": "019e91f5-d4ba-7856-a12d-57b53e244c77"
            }{{ ',' if portabase_dbs[-1] != 'paperless' else '' }}
{% endif %}
{% if 'wygiwyh' in portabase_dbs %}
            {
              "name": "wygiwyh",
              "database": "wygiwyh",
              "type": "postgresql",
              "host": "wygiwyh-cnpg-main-r.wygiwyh.svc.cluster.local",
              "port": 5432,
              "username": "wygiwyh",
              "password": "{{ wygiwyh_database_password }}",
              "generated_id": "019e9357-0423-763b-882a-721d82dcf884"
            }
{% endif %}
          ]
        }
workload:
  main:
    podSpec:
      containers:
        main:
          env:
            EDGE_KEY: {{ portabase_edge_key }}

TZ: "{{ timezone }}"
