{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "additionalBranchPrefix": "{{packageFileDir}}-",
  "commitMessagePrefix": "[{{packageFileDir}}] ",

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "(^|/)Chart\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s?renovate: image=(?<depName>.*?)\\s?appVersion:\\s?\\\"?(?<currentValue>[\\w+\\.\\-]*)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/).*\\.ya?ml$/"
      ],
      "matchStrings": [
        "requested_binary_repo_version:\\s*\"?(?<depName>[^:\"]+?):(?<currentValue>[^\"\r\n]+)\"?"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)execution-environment\\.ya?ml$/"
      ],
      "matchStrings": [
        "base_image:\\s*\\n\\s*name:\\s*\"?(?<depName>[^:\"\\s]+):(?<currentValue>[^@\"\\s]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?-(?<build>\\d+)$"
    },
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/(^|/)deploy.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "$[].vars.requested_image_version.*.( $ref := $substringBefore($, \"@\"); $m := $match($ref, /^(.+):([^:\\/]+)$/); { \"depName\": $m ? $m.groups[0] : $ref, \"currentValue\": $m.groups[1], \"currentDigest\": $contains($, \"@\") ? $substringAfter($, \"@\") } )"
      ],
      "datasourceTemplate": "docker"
    }
  ],

  "enabledManagers": [
    "custom.regex",
    "custom.jsonata",
    "helmv3",
    "helm-values",
    "pre-commit"
  ],

  "helm-values": {
    "managerFilePatterns": [
      "/(^|/).*values.*\\.ya?ml$/"
    ]
  },

  "packageRules": [
    {
      "description": "Images pinned to release-X.Y.Z tags: compare them with plain X.Y.Z tags too, so a switch of tag scheme upstream is picked up",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "/^release-\\d+\\.\\d+\\.\\d+$/",
      "versioning": "regex:^(?:release-)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],

  "pre-commit": {
    "enabled": true
  },

  "prHourlyLimit": 10
}
