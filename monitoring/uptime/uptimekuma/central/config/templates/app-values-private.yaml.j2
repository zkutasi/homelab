configmap:
  autokuma-staticmonitors:
    enabled: true
    expandObjectName: false
    data:
{% for monitor_file in query('ansible.builtin.fileglob', playbook_dir ~ '/config/autokuma-monitors/*.json') | sort %}
      {{ monitor_file | basename }}: |
        {{ lookup('ansible.builtin.file', monitor_file) | indent(8) }}
{% endfor %}
secret:
  ca-certificates:
    enabled: true
    expandObjectName: false
    data:
      homelab-ca.pem: |
        {{ lookup('ansible.builtin.file', 'config/static/certs/ca.crt') | indent(8) }}
workload:
  main:
    podSpec:
      containers:
        autokuma:
          env:
            AUTOKUMA__KUMA__USERNAME: {{ uptimekuma_username }}
            AUTOKUMA__KUMA__PASSWORD: {{ uptimekuma_password }}

TZ: "{{ timezone }}"
