#!/bin/bash

MESSAGE="$1"
CURL="/usr/bin/curl"

if ! ${CURL} -fsS -k --max-time 10 --retry 2 \
  -X POST \
  --data-urlencode "body=${MESSAGE}" \
  --data-urlencode "type=info" \
  --data-urlencode "tags={{ hostvars[inventory_hostname].id }}" \
  {{ apprise_api_hostname }}/notify/{{ apprise_target_key }}; then
  echo "ERROR: Could not send the notification to Apprise"
  exit 1
fi
